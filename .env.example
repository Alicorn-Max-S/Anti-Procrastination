# Copy to .env and fill in. .env is gitignored; never commit real values.

# Canvas: base URL of your school's Canvas and a personal access token
CANVAS_BASE_URL=https://canvas.example.edu
CANVAS_TOKEN=

# Meta Model API (standard tier only; the contributor tier trains on your content)
META_API_KEY=
META_MODEL=muse-spark-1.3
# META_BASE_URL=https://api.meta.ai/v1

# Local files: the SQLite DB, downloaded attachments and graded-test photos (all gitignored)
DB_PATH=data/app.db
FILES_DIR=data/files

# Web push: generate with `python -m app.push`, then paste both keys here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Scheduling: your timezone (blank = this computer's) and the daily window blocks go in
TIMEZONE=America/Los_Angeles
WORK_START_HOUR=15
WORK_END_HOUR=21

# Background loop: Canvas poll interval, how far ahead to make cards, and a cap on model
# cards per sync so the first sync can't spend the whole credit. BACKGROUND=0 turns it off.
BACKGROUND=1
SYNC_MINUTES=5
CARD_HORIZON_DAYS=14
MAX_CARDS_PER_SYNC=5
